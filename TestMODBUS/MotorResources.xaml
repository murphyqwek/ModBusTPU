<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:local="clr-namespace:ModBusTPU.ViewModels.Field">

    <!-- Templates -->
    <DataTemplate x:Key="StringTemplate">
        <StackPanel Orientation="Horizontal">
            <Label Content="{Binding Name}" MinWidth="100" />
            <TextBox Text="{Binding Value}" MinWidth="200" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="IntTemplate">
        <StackPanel Orientation="Horizontal">
            <Label Content="{Binding Name}" MinWidth="100" />
            <TextBox MinWidth="100">
                <TextBox.Text>
                    <Binding Path="Value" UpdateSourceTrigger="LostFocus">
                        <Binding.ValidationRules>
                            <local:IntValidationRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="UshortTemplate">
        <StackPanel Orientation="Horizontal">
            <Label Content="{Binding Name}" MinWidth="100" />
            <TextBox MinWidth="100">
                <TextBox.Text>
                    <Binding Path="Value" UpdateSourceTrigger="LostFocus">
                        <Binding.ValidationRules>
                            <local:UshortValidationRule />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ByteTemplate">
        <StackPanel Orientation="Horizontal">
            <Label Content="{Binding Name}" MinWidth="100" />
            <TextBox MinWidth="100">
                <TextBox.Text>
                    <Binding Path="Value" UpdateSourceTrigger="LostFocus">
                        <Binding.ValidationRules>
                            <local:ByteValidationRule />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="BoolTemplate">
        <StackPanel Orientation="Horizontal">
            <Label Content="{Binding Name}" MinWidth="100" />
            <CheckBox IsChecked="{Binding Value}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DoubleTemplate">
        <StackPanel Orientation="Horizontal">
            <Label Content="{Binding Name}" MinWidth="100" />
            <TextBox MinWidth="100">
                <TextBox.Text>
                    <Binding Path="Value" UpdateSourceTrigger="LostFocus">
                        <Binding.ValidationRules>
                            <local:DoubleValidationRule />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
        </StackPanel>
    </DataTemplate>

    <!-- TemplateSelector -->
    <local:FieldTemplateSelector x:Key="FieldTemplateSelector"
                                 StringTemplate="{StaticResource StringTemplate}"
                                 IntTemplate="{StaticResource IntTemplate}"
                                 ByteTemplate="{StaticResource ByteTemplate}"
                                 UshortTemplate="{StaticResource UshortTemplate}"
                                 BoolTemplate="{StaticResource BoolTemplate}"
                                 DoubleTemplate="{StaticResource DoubleTemplate}" />

</ResourceDictionary>
